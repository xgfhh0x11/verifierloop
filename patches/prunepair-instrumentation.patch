+			/* verifierloop: PRINT-ONLY prune-pair instrumentation.
+			 *
+			 * The only thing this adds is output. It reads no state it does not
+			 * already have in scope, writes nothing, and changes no control flow —
+			 * which is the whole argument for it being legitimate to run: a patch
+			 * that cannot change a verdict is not "changing the thing under test",
+			 * and that claim is CHECKABLE by requiring byte-identical verdicts from
+			 * the stock and instrumented kernels over the same corpus.
+			 *
+			 * Why it is needed: the log announces that a prune happened and carries
+			 * NEITHER side's state, and even print_verifier_state cannot express the
+			 * predicate's domain — range_within is arc containment on cnum{base,size}
+			 * while the log prints eight derived projections, `precise` decides
+			 * whether the check runs at all and appears only as a `P` prefix, and
+			 * `id` is printed with BPF_ADD_CONST masked off. So the raw fields are
+			 * printed, not a rendering of them.
+			 */
+			if (env->log.level & BPF_LOG_LEVEL2) {
+				struct bpf_verifier_state *vs[2] = { &sl->state, cur };
+				const char *nm[2] = { "old", "cur" };
