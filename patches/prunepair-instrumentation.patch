+								(unsigned long long)r->r64.base,
+								(unsigned long long)r->r64.size,
+								(unsigned int)r->r32.base,
+								(unsigned int)r->r32.size,
+								r->id, r->parent_id,
+								r->frameno, r->precise ? 1 : 0);
+						}
+					}
+				}
+			}
